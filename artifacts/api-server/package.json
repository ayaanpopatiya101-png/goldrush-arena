{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:leaderboard": "node scripts/test-leaderboard.mjs",
    "test:leaderboard-api": "node scripts/test-leaderboard.mjs --api",
    "test:workshop": "node scripts/test-workshop.mjs",
    "test:workshop-api": "node scripts/test-workshop.mjs --api",
    "test:store": "node scripts/test-store.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@opentelemetry/api": "^1.10.0",
    "@replit/connectors-sdk": "^0.7.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/goldrush-catalog": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.3",
    "libphonenumber-js": "^1.13.16",
    "pg-boss": "^12.38.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "stripe": "^22.3.2",
    "stripe-replit-sync": "^1.0.0",
    "twilio": "^6.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
